# Copy this file to .env and fill in real values locally. Never commit .env.

APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db

# AI bonus (Campaign Review Brief) — OpenRouter. Leave OPENROUTER_API_KEY unset
# to run with the AI bonus disabled (core dashboard works either way).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
